# Los hashes de releases corresponden a sus bytes originales, fuera de Git.
# LF para fuentes que se empaquetan o ejecutan en Android/Linux.
* text=auto
*.py text eol=lf
*.go text eol=lf
*.java text eol=lf
*.sh text eol=lf
*.rc text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.txt text eol=lf
*.log text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
.gitignore text eol=lf
.gitattributes text eol=lf

# No reinterpretar como texto artefactos incorporados de forma excepcional.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.img binary
*.apk binary
*.zip binary
*.gz binary
*.xz binary
*.jks binary
*.pk8 binary

# Preparadores SD sellados con hashes sobre LF: conservar bytes al clonar.
/preparacion-usb/preparar-sd-rk3229-c.ps1 text eol=lf
/preparacion-usb/continuar-sd-rk3229-c.ps1 text eol=lf
/preparacion-usb/entregar-sd-rk3229-c.ps1 text eol=lf
/preparacion-usb/tests/test-preparar-sd-rk3229-c.ps1 text eol=lf
/preparacion-usb/finalizar-sd-rk3229-c.ps1 text eol=lf
/preparacion-usb/entregar-sd-rk3229-c-final.ps1 text eol=lf
/preparacion-usb/preparar-sd-rk3229-c-02.ps1 text eol=lf
/diagnostico/extractor-recovery-0.2/*.go text eol=lf
/diagnostico/extractor-recovery-0.2/go.mod text eol=lf
# Recibos sellados: conservar CRLF de ConvertTo-Json y el cierre LF exactos.
/preparacion-usb/sd-rk3229-c-02-estado.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/docs/evidencia/SD-02-LECTURA-FINAL.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
