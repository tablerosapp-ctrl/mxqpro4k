*.py[cod]
.pytest_cache/
.mypy_cache/
.venv/
node_modules/
.cache/
gocache/
go-cache/
*.tmp
*.temp
*.part
*.download
*.swp
Thumbs.db
Desktop.ini
.DS_Store
